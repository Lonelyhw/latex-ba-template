% references.bib
% Literaturverzeichnis im BibTeX-Format.
% Jeder Eintragstyp ist einmal als Beispiel vorhanden.
% Tipp: Viele Verlage bieten einen "BibTeX exportieren"-Button an.

% --- BUCH ---
@book{beispiel_buch_2020,
    address   = {Muenchen},
    edition   = {3},
    title     = {Titel des Buches},
    publisher = {Verlagsname},
    author    = {Nachname, Vorname and Zweitautor, Vorname},
    year      = {2020},
}

% --- ZEITSCHRIFTENARTIKEL ---
@article{beispiel_artikel_2019,
    title   = {Titel des Artikels},
    volume  = {15},
    number  = {2},
    pages   = {123--145},
    journal = {Name der Zeitschrift},
    author  = {Nachname, Vorname and Zweitautor, Vorname},
    year    = {2019},
    doi     = {10.xxxx/xxxxxxx},
}

% --- KONFERENZBEITRAG ---
@inproceedings{beispiel_konferenz_2022,
    title     = {Titel des Konferenzbeitrags},
    booktitle = {Proceedings of the XY Conference},
    publisher = {IEEE},
    author    = {Nachname, Vorname and Zweitautor, Vorname},
    year      = {2022},
    pages     = {1--10},
    doi       = {10.xxxx/xxxxxxx},
}

% --- ONLINE-QUELLE ---
@misc{beispiel_online_2024,
    title   = {Titel der Webseite oder des Berichts},
    url     = {https://www.beispiel.de/seite},
    author  = {{Organisationsname}},     % Bei Organisationen doppelte geschweifte Klammern
    year    = {2024},
    urldate = {2024-01-01},              % Datum des letzten Zugriffs (YYYY-MM-DD)
}
